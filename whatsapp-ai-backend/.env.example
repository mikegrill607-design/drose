# Bootstrap secrets only. WhatsApp Business credentials (App ID, Phone Number ID,
# Access Token, Verify Token) and LLM provider + API key (Groq or OpenAI -- each
# client can bring their own) are NOT set here -- they're entered once through the
# dashboard's Settings page after deploy and stored in the `app_settings` table.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# This service's own public URL (e.g. https://your-app.up.railway.app), so the
# Settings page can display the exact webhook callback URL to paste into Meta.
WEBHOOK_BASE_URL=

PORT=3000
